FROM node:18.20.8-bookworm-slim

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . ./

# Keep local compilation within the memory budget of small Docker Desktop hosts.
ENV NG_BUILD_MAX_WORKERS=2

EXPOSE 4200
CMD ["npm", "start", "--", "--configuration", "local-preview", "--host", "0.0.0.0", "--poll", "2000"]
